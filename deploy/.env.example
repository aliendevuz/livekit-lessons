# Serverning ochiq IP manzili
SERVER_IP=203.0.113.10

# Domen. O'z domeningiz bo'lmasa: IP dagi nuqtalarni chiziqcha qilib, oxiriga .sslip.io qo'shing —
# u o'zi shu IP ga yo'naladi va HTTPS sertifikat olinadi.
DOMAIN=203-0-113-10.sslip.io

# Birinchi admin
ADMIN_USERNAME=admin
ADMIN_PINCODE=

# Quyidagi uchtasi tasodifiy bo'lishi shart (LIVEKIT_API_SECRET kamida 32 belgi):
#   openssl rand -hex 32
LIVEKIT_API_KEY=lesson
LIVEKIT_API_SECRET=
MEDIA_SECRET=

# Telegram bot. Bo'sh bo'lsa havolalar faqat logga yoziladi.
BOT_TOKEN=

# Sinov rejimi: 1 bo'lsa login sahifasida tayyor userlar chiqadi va ularga pincode'siz kiriladi.
# DIQQAT: havolani bilgan har kim admin bo'lib kira oladi. Haqiqiy foydalanuvchilar bilan yoqmang.
DEMO_MODE=
# Nechta tayyor guruh va o'quvchi (bo'sh bo'lsa 2 guruh, 10 o'quvchi). Har guruhga bitta teacher,
# o'quvchilar teng bo'linadi. Bitta darsga 50 kishi kerak bo'lsa: DEMO_GROUPS=1, DEMO_STUDENTS=49.
DEMO_GROUPS=
DEMO_STUDENTS=
