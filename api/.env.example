# Birinchi admin. ADMIN_PINCODE bo'sh bo'lsa admin yaratilmaydi.
ADMIN_USERNAME=admin
ADMIN_PINCODE=1234

# LiveKit (`livekit-server --dev` standart qiymatlari)
LIVEKIT_URL=ws://localhost:7880
# Brauzer boshqa manzil orqali ulansa (tunnel, domen) — API ichkaridan shu manzilni ishlatadi
LIVEKIT_INTERNAL_URL=
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Media backend. MEDIA_SECRET ikkala backendda bir xil bo'lishi shart.
MEDIA_URL=http://localhost:8001
MEDIA_INTERNAL_URL=
MEDIA_SECRET=change-me-to-a-long-random-string

# Telegram. BOT_TOKEN bo'sh bo'lsa havolalar faqat logga yoziladi.
BOT_TOKEN=
WEBAPP_URL=http://localhost:8000

CORS_ORIGINS=*

# Sinov rejimi: 1 bo'lsa login sahifasida tayyor userlar chiqadi va ularga pincode'siz kiriladi.
# DIQQAT: havolani bilgan har kim admin bo'lib kira oladi. Haqiqiy foydalanuvchilar bilan yoqmang.
DEMO_MODE=
