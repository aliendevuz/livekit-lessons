# API backend'dagi MEDIA_SECRET bilan bir xil bo'lishi shart.
MEDIA_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=*

# MP4 ga o'tkazish. CRF katta bo'lsa fayl kichik, sifat past (23 yaxshi, 28 tejamkor).
VIDEO_CRF=28
# 0 = barcha yadrolar. Kuchsiz serverda 1 qo'ying.
FFMPEG_THREADS=0
# Bo'sh bo'lsa tizimdagi ffmpeg, u ham bo'lmasa pip bilan kelgani ishlatiladi.
FFMPEG_BIN=
